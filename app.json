{
  "expo": {
    "name": "iCalc",
    "slug": "iCalc",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icalc-logo.png",
    "scheme": "icalc",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/images/icalc-logo.png",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Allow iCalc to connect to Bluetooth thermal printers.",
        "NSBluetoothPeripheralUsageDescription": "Allow iCalc to connect to Bluetooth thermal printers."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icalc-logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/icalc-logo.ico"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/icalc-logo.png",
          "android": {
            "image": "./assets/images/icalc-logo.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
